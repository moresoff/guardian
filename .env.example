# Copiar a .env.local y completar. `.env*` está en .gitignore: no subir este
# archivo con valores reales adentro.

# La cadena de conexión a Postgres.
#
# Sin esta variable la app corre contra el seed en memoria, que es lo que hace
# que un clon recién bajado levante y se vea. Con ella, contra la base.
#
# En Supabase sale de Project Settings → Database → Connection string → URI, y
# conviene la del pooler en modo transacción (puerto 6543): Next abre y cierra
# conexiones seguido y el pooler es el que aguanta eso. DIRECT_URL es el mismo
# servidor en modo sesión (5432) y la usan las migraciones.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:6543/postgres
#
# Para un Postgres local:
#
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guardian
DATABASE_URL=

# El proyecto de Supabase. La clave publicable es pública por diseño: viaja al
# navegador y no da acceso a nada por sí sola, porque las tablas tienen RLS. Se
# usan para el login y la subida de archivos, no para leer datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# El mismo servidor en modo sesión, para las migraciones.
DIRECT_URL=

# La clave secreta del proyecto (Project Settings → API Keys → Secret keys,
# empieza con sb_secret_). Solo la usa el servidor, para guardar y leer los
# archivos del bucket privado `documentos`: los papeles del proyecto y las fotos
# de la validación de identidad. NUNCA va con NEXT_PUBLIC_ adelante.
#
# Sin ella, los archivos se guardan en la carpeta .almacen/ del proyecto.
SUPABASE_SECRET_KEY=

# El correo de contacto que se muestra en las pantallas abiertas (portada,
# catálogo, ficha pública) para consultar por modalidades de participación.
# Sin valor se usan estos mismos.
NEXT_PUBLIC_CORREO_CONTACTO=guardian@gmail.com
NEXT_PUBLIC_TELEFONO_CONTACTO=11 1234 5678

# Clave con la que se firma la cookie de sesión. Cualquier texto largo y al azar;
# sin ella se usa una de desarrollo, que no sirve para producción.
SESION_SECRETO=
